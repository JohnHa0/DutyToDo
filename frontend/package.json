{
  "name": "dutytodo",
  "private": true,
  "version": "1.0.1",
  "type": "module",
  "main": "main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173/ electron .\"",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "electron:build": "vite build && electron-builder"
  },
  "dependencies": {
    "@ant-design/icons": "^6.3.2",
    "@fullcalendar/core": "^6.1.15",
    "@fullcalendar/daygrid": "^6.1.15",
    "@fullcalendar/react": "^6.1.15",
    "@fullcalendar/timegrid": "^6.1.15",
    "antd": "^6.6.2",
    "axios": "^1.20.0",
    "dayjs": "^1.11.23",
    "react": "^19.2.8",
    "react-calendar-heatmap": "^1.10.0",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.3",
    "react-tooltip": "^6.0.8",
    "recharts": "^3.10.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-calendar-heatmap": "^1.9.0",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "oxlint": "^1.79.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.2",
    "wait-on": "^9.1.0"
  },
  "build": {
    "appId": "com.dutytodo.app",
    "productName": "值班助手",
    "directories": {
      "output": "dist-electron"
    },
    "linux": {
      "target": [
        "deb"
      ],
      "category": "Office",
      "icon": "build/icons"
    },
    "extraResources": [
      {
        "from": "../backend/dist/backend_server",
        "to": "backend_server"
      }
    ],
    "icon": "build/icon.png"
  },
  "author": "DutyToDo Team <team@dutytodo.local>",
  "description": "值班通知智能流转系统",
  "homepage": "https://github.com/DutyToDo"
}